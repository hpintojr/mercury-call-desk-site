# Copy to .env.local (never commit .env.local). Add the same keys in Vercel > Project > Settings > Environment Variables.

# Canonical site URL (sitemap/robots/OG)
NEXT_PUBLIC_SITE_URL=https://mercurycalldesk.com

# ── Sulus CRM (crm.sulus.ai) — contact form delivery ───────────────────────────────
# Preferred: API upsert into your sub-account.
#   CRM_LOCATION_ID  = the id in your CRM URL: https://crm.sulus.ai/location/<THIS>
#   CRM_API_TOKEN    = Sulus CRM → Settings → Private Integrations → create token with contacts.write
CRM_LOCATION_ID=6R986ILIQydGAU4T1l74
CRM_API_TOKEN=
# Optional overrides (defaults shown)
# CRM_API_BASE=https://services.leadconnectorhq.com
# CRM_API_VERSION=2021-07-28

# Fallback: a workflow "Inbound Webhook" trigger URL (used only if the API vars above are empty)
CRM_WEBHOOK_URL=
